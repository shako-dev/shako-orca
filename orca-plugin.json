{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "shako",
  "name": "Shako",
  "version": "0.1.0",
  "description": "Cloud VMs that sleep when idle. Sign up, register this computer's SSH key, and let your agents create VMs and host apps.",
  "author": { "name": "Shako", "url": "https://shako.dev" },
  "repository": "https://github.com/shako-dev/shako-orca",
  "homepage": "https://shako.dev",
  "license": "MIT",
  "engines": { "orca": ">=1.4.248" },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      { "id": "setup", "title": "Shako", "icon": "cloud", "entry": "panel/panel.tsx", "ui": "components" }
    ],
    "commands": [{ "id": "shako.status", "title": "Shako: Status" }],
    "statusBarItems": [
      { "id": "shako", "text": "Shako", "icon": "cloud", "tooltip": "Shako", "command": "shako.status" }
    ]
  },
  "capabilities": [{ "kind": "notifications:show" }, { "kind": "storage:own" }]
}
